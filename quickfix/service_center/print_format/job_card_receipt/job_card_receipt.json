 "html": "<style>\n\n@page {\n    size: A4;\n    margin: 1cm;\n}\n\n@media print {\n\n    .no-print {\n        display: none;\n    }\n}\n\n.page-break {\n    page-break-before: always;\n}\n\n.final-amount {\n\n    font-size: 24px;\n\n    font-weight: bold;\n\n    margin-top: 20px;\n}\n\n.urgent-banner {\n\n    background: red;\n\n    color: white;\n\n    text-align: center;\n\n    padding: 10px;\n\n    font-size: 20px;\n\n    font-weight: bold;\n\n    margin-bottom: 20px;\n}\n\ntable {\n\n    width: 100%;\n\n    border-collapse: collapse;\n\n    margin-top: 10px;\n}\n\ntable,\nth,\ntd {\n\n    border: 1px solid black;\n}\n\nth,\ntd {\n\n    padding: 8px;\n\n    text-align: left;\n}\n\n.section-title {\n\n    margin-top: 20px;\n\n    font-size: 18px;\n\n    font-weight: bold;\n}\n\n</style>\n\n\n<h1>\n\n    {{ get_shop_name() }}\n\n</h1>\n\n\n{% if doc.priority == \"Urgent\" %}\n\n<div class=\"urgent-banner\">\n\n    {{ _(\"URGENT\") }}\n\n</div>\n\n{% endif %}\n\n\n<div class=\"section-title\">\n\n    {{ _(\"Customer Details\") }}\n\n</div>\n\n<p>\n\n    <b>{{ _(\"Customer Name\") }}:</b>\n    {{ doc.customer_name }}\n\n</p>\n\n<p>\n\n    <b>{{ _(\"Phone\") }}:</b>\n    {{ doc.customer_phone }}\n\n</p>\n\n\n<div class=\"section-title\">\n\n    {{ _(\"Device Details\") }}\n\n</div>\n\n<p>\n\n    <b>{{ _(\"Brand\") }}:</b>\n    {{ doc.device_brand }}\n\n</p>\n\n<p>\n\n    <b>{{ _(\"Model\") }}:</b>\n    {{ doc.device_model }}\n\n</p>\n\n<p>\n\n    <b>{{ _(\"Device Type\") }}:</b>\n    {{ doc.device_type }}\n\n</p>\n\n<p>\n\n    <b>{{ _(\"Problem\") }}:</b>\n    {{ doc.problem_description }}\n\n</p>\n\n\n{% if doc.parts_used|length > 10 %}\n\n<div class=\"page-break\"></div>\n\n{% endif %}\n\n\n<div class=\"section-title\">\n\n    {{ _(\"Parts Used\") }}\n\n</div>\n\n\n<table>\n\n    <thead>\n\n        <tr>\n\n            <th>{{ _(\"Part\") }}</th>\n\n            <th>{{ _(\"Qty\") }}</th>\n\n            <th>{{ _(\"Rate\") }}</th>\n\n            <th>{{ _(\"Total\") }}</th>\n\n        </tr>\n\n    </thead>\n\n    <tbody>\n\n        {% for row in doc.parts_used %}\n\n        <tr>\n\n            <td>\n                {{ row.part_name }}\n            </td>\n\n            <td>\n                {{ row.quantity }}\n            </td>\n\n            <td>\n\n                {{ frappe.format_value(\n                    row.unit_price,\n                    {\"fieldtype\": \"Currency\"}\n                ) }}\n\n            </td>\n\n            <td>\n\n                {{ frappe.format_value(\n                    row.total_price,\n                    {\"fieldtype\": \"Currency\"}\n                ) }}\n\n            </td>\n\n        </tr>\n\n        {% endfor %}\n\n    </tbody>\n\n</table>\n\n\n<h2 class=\"final-amount\">\n\n    {{ _(\"Final Amount\") }}:\n\n    {{ frappe.format_value(\n        doc.final_amount,\n        {\"fieldtype\": \"Currency\"}\n    ) }}\n\n</h2>\n\n\n<div class=\"section-title\">\n\n    {{ _(\"Summary\") }}\n\n</div>\n\n<p>\n\n    {{ doc.print_summary }}\n\n</p>\n\n\n<div style=\"margin-top: 20px;\">\n\n    <img\n        src=\"{{ get_qr_code(doc.name) }}\"\n        width=\"120\"\n    >\n\n</div>",
